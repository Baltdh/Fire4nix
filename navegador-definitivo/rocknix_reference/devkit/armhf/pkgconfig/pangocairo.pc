prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib32

Name: Pango Cairo
Description: Cairo rendering support for Pango
Version: 1.56.4
Requires: pango, cairo
Requires.private: pangoft2, glib-2.0 >=  2.82, gobject-2.0 >=  2.82, gio-2.0 >=  2.82, fribidi >=  1.0.6, libthai >=  0.1.9, harfbuzz >=  8.4.0, fontconfig >=  2.15.0, freetype2, xrender, xft >=  2.0.0, zlib, libpng >=  1.4.0, x11, xext, xcb >=  1.6, xcb-render >=  1.6, xcb-shm, pixman-1 >=  0.40.0
Libs: -L${libdir} -lpangocairo-1.0
Libs.private: -lm -ldl
Cflags: -I${includedir}/pango-1.0
