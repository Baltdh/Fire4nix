prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib32

Name: cairo
Description: Multi-platform 2D graphics library
Version: 1.18.5
Requires.private: zlib, libpng >=  1.4.0, fontconfig >=  2.15.0, freetype2, x11, xext, xrender, xcb >=  1.6, xcb-render >=  1.6, xcb-shm, pixman-1 >=  0.40.0
Libs: -L${libdir} -lcairo
Libs.private: -lm -ldl
Cflags: -I${includedir}/cairo
