prefix=/usr
includedir=${prefix}/include
libdir=${prefix}/lib32

have_drm_backend=true
have_x11_backend=false
have_libinput_backend=true
have_xwayland=true
have_gles2_renderer=true
have_vulkan_renderer=false
have_gbm_allocator=true
have_udmabuf_allocator=true
have_session=true
have_color_management=false

Name: wlroots-0.19
Description: Wayland compositor library
URL: https://gitlab.freedesktop.org/wlroots/wlroots
Version: 0.19.3
Requires.private: wayland-server >= 1.23.1, libdrm >= 2.4.122, xkbcommon, pixman-1 >= 0.43.0, egl, gbm, glesv2, libudev, libseat >= 0.2.0, libdisplay-info, libinput >= 1.19.0, wayland-client >= 1.23.1, xcb, xcb-composite, xcb-ewmh, xcb-icccm, xcb-render, xcb-res, xcb-xfixes
Libs: -L${libdir} -lwlroots-0.19
Libs.private: -lm -lrt
Cflags: -I${includedir}/wlroots-0.19
