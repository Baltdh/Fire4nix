# Fire4Nix staged reference environment
_fire4nix_reference_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
_fire4nix_reference_home="$(cd "$_fire4nix_reference_env_dir/.." && pwd)"
export FIRE4NIX_REFERENCE_ROOT="${FIRE4NIX_REFERENCE_ROOT:-$_fire4nix_reference_home/rocknix_reference}"
export FIRE4NIX_REFERENCE_SUMMARY="reference root=$_fire4nix_reference_home/rocknix_reference • dbus-session dbus-system network-manager fonts ssl systemd logind journald iocost udev gtk-im at-spi foot swayimg mangohud wayland systemd-profile box64 gpu tmpfiles pkgconfig-armhf lib32-snapshot python313"
export FIRE4NIX_REFERENCE_FEATURES="dbus-session dbus-system dbus-policies nm-priv-helper nm-dispatcher networkmanager avahi fonts ssl systemd logind journald oomd resolved sleep timesyncd pstore iocost systemd-user udev gtk-im at-spi foot swayimg mangohud profile-001 profile-002 profile-010 profile-045 profile-050 profile-090 profile-095 profile-098 profile-101 tmpfiles pkgconfig-armhf lib32-snapshot python313"
export FIRE4NIX_REFERENCE_STATUS="reference_root=$_fire4nix_reference_home/rocknix_reference • reference_summary=reference root=$_fire4nix_reference_home/rocknix_reference • dbus-session dbus-system network-manager fonts ssl systemd logind journald iocost udev gtk-im at-spi foot swayimg mangohud wayland systemd-profile box64 gpu tmpfiles pkgconfig-armhf lib32-snapshot python313 • reference_features=dbus-session dbus-system dbus-policies nm-priv-helper nm-dispatcher networkmanager avahi fonts ssl systemd logind journald oomd resolved sleep timesyncd pstore iocost systemd-user udev gtk-im at-spi foot swayimg mangohud profile-001 profile-002 profile-010 profile-045 profile-050 profile-090 profile-095 profile-098 profile-101 tmpfiles pkgconfig-armhf lib32-snapshot python313 • reference_manifest=$$_fire4nix_reference_home/.fire4nix/reference-manifest.txt • reference_env=$$_fire4nix_reference_home/.fire4nix/reference.env"
export FIRE4NIX_REFERENCE_MANIFEST="${FIRE4NIX_REFERENCE_MANIFEST:-$_fire4nix_reference_home/.fire4nix/reference-manifest.txt}"
export FIRE4NIX_REFERENCE_ENV="${FIRE4NIX_REFERENCE_ENV:-$_fire4nix_reference_home/.fire4nix/reference.env}"
export FONTCONFIG_FILE="${FONTCONFIG_FILE:-$_fire4nix_reference_home/rocknix_reference/etc/fonts/fonts.conf}"
export SSL_CERT_FILE="${SSL_CERT_FILE:-/etc/ssl/certs/ca-certificates.crt}"
export GTK_IM_MODULE="${GTK_IM_MODULE:-simple}"
export GTK_ENABLE_ACCESSIBILITY="${GTK_ENABLE_ACCESSIBILITY:-1}"
export GTK_MODULES="${GTK_MODULES:-atk-bridge}"
export QT_ACCESSIBILITY="${QT_ACCESSIBILITY:-1}"
export NO_AT_BRIDGE="${NO_AT_BRIDGE:-0}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Sway}"
export SYSTEMD_COLORS="${SYSTEMD_COLORS:-0}"
export BOX64_PREFER_EMULATED="${BOX64_PREFER_EMULATED:-1}"
export BOX64_LD_LIBRARY_PATH="${BOX64_LD_LIBRARY_PATH:-/usr/share/box64/lib}"
export BOX64_BASH="${BOX64_BASH:-/usr/bin/bash-x64}"
export BOX64_LOG="${BOX64_LOG:-0}"
if [ -d "${_fire4nix_reference_home}/rocknix_reference/devkit/armhf/pkgconfig" ]; then
    export PKG_CONFIG_PATH="${PKG_CONFIG_PATH:-${_fire4nix_reference_home}/rocknix_reference/devkit/armhf/pkgconfig}"
fi
if [ -d "${_fire4nix_reference_home}/rocknix_reference/runtime-libs/armhf/lib32-snapshot" ]; then
    export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-${_fire4nix_reference_home}/rocknix_reference/runtime-libs/armhf/lib32-snapshot}"
    export LIBRARY_PATH="${LIBRARY_PATH:-${_fire4nix_reference_home}/rocknix_reference/runtime-libs/armhf/lib32-snapshot}"
fi
if [ -d "${_fire4nix_reference_home}/rocknix_reference/etc/tmpfiles.d" ]; then
    export FIRE4NIX_TMPFILES_DIR="${FIRE4NIX_TMPFILES_DIR:-${_fire4nix_reference_home}/rocknix_reference/etc/tmpfiles.d}"
fi
export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}"
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
